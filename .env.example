# ---------------------------------------------------------------- app
APP_URL=https://flexiprint.next.lc
APP_DOMAIN=flexiprint.next.lc

# ---------------------------------------------------------------- Supabase (self-hosted, /opt/flexiprint/supabase/.env)
NEXT_PUBLIC_SUPABASE_URL=https://flexiprint.next.lc
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DB_SCHEMA=flexiprint

# ---------------------------------------------------------------- Cloudflare R2 (all files)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=anr2
R2_KEY_PREFIX=flexiprint
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Python services (docker-compose sets the URLs)
# Local `npm run dev` starts them on 7001, 7003, 7004:
CT_BG_REMOVER_URL=http://127.0.0.1:7001
CT_MATERIAL_URL=http://127.0.0.1:7003
CT_FACE_DETECT_URL=http://127.0.0.1:7004

# ---------------------------------------------------------------- AI (optional plugins)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# FAL_KEY=
# Team image API (OpenAI-compatible) — the photo cut-out fallback (server/ai/providers.ts):
# OPENAI_BASE_URL=https://cpa.next.lc/v1
# OPENAI_EDITS_JSON=1
# OPENAI_IMAGE_MODELS=gpt-image-2,gpt-image-2.5,gpt-image-1.5,grok-imagine-image-quality
# Company image API for the v2 bộ nhân vật (server/pack-images.ts drawImage, "cpa:<model>"):
# CPA_BASE_URL=https://cpa.next.lc/v1
# CPA_API_KEY=

# ---------------------------------------------------------------- storefront / cron
# CT_ALLOWED_ORIGINS=https://giftself-2.myshopify.com
CT_CRON_SECRET=
# CT_CACHE_TTL_HOURS=24
# CT_AI_DAILY_LIMIT=300
# CT_AI_IP_DAILY_LIMIT=12

# The editor's own agent (@flexiprint on agent_ide: deploy content, v2 bộ nhân vật) — integrations/agent-ide/README.md
# AGENT_IDE_URL: agent_ide's public address; AGENT_IDE_TOKEN: its svc_… service token for the @flexiprint project.
# CT_AGENT_TOKEN: the bearer the agent uses for flexiprint-mcp (/api/customize-tool/mcp) — any long random string.
AGENT_IDE_URL=
AGENT_IDE_TOKEN=
CT_AGENT_TOKEN=
# Vision LLM (fal any-llm) that locates faces for the face photo styles, default google/gemini-2.5-flash
# CT_PROMPT_MODEL=
