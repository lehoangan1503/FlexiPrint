# ---------------------------------------------------------------- app
APP_URL=https://flexiprint.next.lc
APP_DOMAIN=flexiprint.next.lc

# ---------------------------------------------------------------- Supabase (self-hosted, /opt/flexiprint/supabase/.env)
NEXT_PUBLIC_SUPABASE_URL=https://flexiprint.next.lc
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DB_SCHEMA=flexiprint

# ---------------------------------------------------------------- Cloudflare R2 (all files)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=anr2
R2_KEY_PREFIX=flexiprint
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Python services (docker-compose sets the URLs)
# Local `npm run dev` starts them on 7001–7003:
CT_BG_REMOVER_URL=http://127.0.0.1:7001
CT_PHOTO_STYLE_URL=http://127.0.0.1:7002
CT_MATERIAL_URL=http://127.0.0.1:7003

# ---------------------------------------------------------------- AI (optional plugins)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# FAL_KEY=
# Team image API (OpenAI-compatible) for the editor's "Tạo bằng AI":
# OPENAI_BASE_URL=https://cpa.next.lc/v1
# OPENAI_EDITS_JSON=1
# OPENAI_IMAGE_MODELS=gpt-image-2,gpt-image-2.5,gpt-image-1.5,grok-imagine-image-quality

# ---------------------------------------------------------------- ComfyUI studio (services/comfy)
# CT_COMFY_TOKEN=            # node pack → internal API (compose passes it to comfy as FP_COMFY_TOKEN)
# CT_STUDIO_SECRET=          # signs the fp_studio cookie nginx checks
# CT_STUDIO_URL=https://flexiprint-studio.next.lc
# CT_STUDIO_COOKIE_DOMAIN=.next.lc
# CT_STUDIO_USER_ID=         # owner of studio-made cliparts (default: first superadmin)
# CPA_BASE_URL=https://cpa.next.lc/v1
# CPA_API_KEY=

# ---------------------------------------------------------------- storefront / cron
# CT_ALLOWED_ORIGINS=https://giftself-2.myshopify.com
CT_CRON_SECRET=
# CT_CACHE_TTL_HOURS=24
# CT_AI_DAILY_LIMIT=300
# CT_AI_IP_DAILY_LIMIT=12
