    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "@flexiprint — Claude Code (gói thuê bao)"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "skill flexiprint-category:"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "đọc → giải thích vì sao ảnh ra như vậy"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "→ viết bản trước / sau, ghép thử bằng assemble_prompts"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "→ tạo ảnh thử nếu cần"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "→ HỎI người nhờ đồng ý"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "→ lưu, báo lại mã lịch sử"
        }
       ]
      }
     ]
    }
   }
  },
